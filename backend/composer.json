{
    "name": "tytnik-dev/viagem-backend",
    "description": "Backend for Viagem interview task",
    "type": "project",
    "require": {
        "php": "^8.3",
        "php-di/php-di": "^7.1",
        "slim/psr7": "^1.8",
        "slim/slim": "^4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix"
    }
}
